# MyPA site — Caddyfile snippet
#
# Replace MYPA_SITE_HOST with your chosen subdomain (e.g. mypa-site.example.com),
# append this block to /etc/caddy/Caddyfile, validate, reload Caddy.
#
# Deployment assumes the site files live at /var/www/mypa-site/.
# `rsync -avz --delete . root@<vps>:/var/www/mypa-site/` (excluding .git).

MYPA_SITE_HOST {
    encode gzip zstd

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "strict-origin-when-cross-origin"
        # Sensible CSP for the static page: only Google Fonts + the jsdelivr GSAP.
        Content-Security-Policy "default-src 'self'; style-src 'self' https://fonts.googleapis.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self' https://cdn.jsdelivr.net; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'"
    }

    root * /var/www/mypa-site
    try_files {path} {path}/ /index.html
    file_server

    # Long cache for assets, short for HTML.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=604800, immutable"
    @html path /
    header @html Cache-Control "public, max-age=300"
}
