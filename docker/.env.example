# =============================================================
# MyPA Docker Compose configuration
#
# Copy this file to .env in the same directory and fill in the
# values. Then: docker compose up -d
#
# Tip — to generate the random secrets in one shot:
#   openssl rand -base64 48 | tr -d "\n=+/" | head -c 64
# Run that 5 times, paste the outputs into the *_SECRET / *_KEY fields.
# =============================================================

# --- Hostnames ---
# Point DNS A records for both at this Docker host's public IP BEFORE
# starting the stack — Caddy needs them resolvable to issue Let's
# Encrypt certificates.
PUBLIC_HOST=mypa.example.com
NTFY_HOST=ntfy.example.com
LETSENCRYPT_EMAIL=you@example.com

# --- Operator identity ---
USER_NAME=alice
TZ=Europe/London
LOCALE=en-GB

# --- Admin user (created on first boot if it doesn't exist) ---
MYPA_ADMIN_EMAIL=you@example.com
MYPA_ADMIN_PASSWORD=change-this-to-a-strong-password
MYPA_ADMIN_NAME=Alice

# --- Secrets — generate fresh random values for each ---
BEARER_TOKEN_RW=REPLACE-WITH-RANDOM-40-CHARS
BEARER_TOKEN_RO=REPLACE-WITH-RANDOM-40-CHARS
SQLCIPHER_KEY=REPLACE-WITH-RANDOM-64-CHARS-LOSE-THIS-LOSE-DATABASE
OAUTH_JWT_SECRET=REPLACE-WITH-RANDOM-64-CHARS

# --- ntfy auth (mypa-api uses these to publish; admin manages users) ---
NTFY_ADMIN_USER=admin
NTFY_ADMIN_PASSWORD=REPLACE-WITH-RANDOM-32-CHARS
NTFY_PUBLISH_USER=mypa-publisher
NTFY_PUBLISH_PASSWORD=REPLACE-WITH-RANDOM-32-CHARS

# --- Behaviour flags (defaults are sensible — usually leave alone) ---
IMPLICIT_LOCATION_CAPTURE=false
IMAGE_EXTRACTION_ENABLED=false
OUTCOME_NUDGE_ENABLED=false
NTFY_USER_MGMT_ENABLED=true
NOTIFY_SCHEDULER_ENABLED=true

# --- Optional integrations (leave blank unless using) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OPENAI_API_KEY=

# --- Dashboard build (advanced — usually leave as defaults) ---
# Pin to a specific commit or tag if you want reproducible builds.
DASHBOARD_REPO=https://github.com/kensterinvest/mypa-dashboard.git
DASHBOARD_REF=main
